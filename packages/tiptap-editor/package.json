{
  "name": "@luhanxin/tiptap-editor",
  "version": "0.0.0",
  "description": "@luhanxin/tiptap-editor package (scaffolded by lhx-cli add package).",
  "keywords": [
    "lhx-kit"
  ],
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juwenzhang/lhx-kit.git",
    "directory": "packages/tiptap-editor"
  },
  "homepage": "https://juwenzhang.github.io/lhx-kit/",
  "bugs": {
    "url": "https://github.com/juwenzhang/lhx-kit/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@lhx-kit/tsconfig": "1.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
