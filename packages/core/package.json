{
  "name": "@luhanxin/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@luhanxin/api-client": "workspace:*",
    "@luhanxin/error-monitor": "workspace:*",
    "@luhanxin/tiptap-editor": "workspace:*",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.2"
  }
}
