SERVER_HOST=0.0.0.0
SERVER_PORT=4000
# 对齐 apps/api 的 NODE_ENV 用法：开发环境日志走人类可读的 pretty 格式，生产环境
# （部署时改成 APP_ENV=production）走 JSON（见 src/main.rs 顶部注释）
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://user:password@localhost:5432/yjs-docs
# 与 apps/api 的 JWT_SECRET 保持完全一致（见 design.md 决策 3：本地校验 access token 签名）
JWT_SECRET=secret
# apps/api 新增 gRPC server 的地址（见 design.md 决策 2/10）；本地开发用 127.0.0.1
# 而不是 localhost，避免被解析成 IPv6 ::1 导致连接失败（实测踩过这个坑，见
# utils/config.rs 顶部注释）；docker-compose 部署时换成服务名，如 http://api:4011。
# 端口用 4011 而不是 4001：本机实测在 macOS 上会跟 QQ 桌面客户端占用的 127.0.0.1:4001
# 撞车，症状跟"apps/api 没启动"一模一样（见 utils/config.rs 顶部注释）
API_GRPC_ADDR=http://127.0.0.1:4011
# 周期性持久化触发间隔（秒），见 design.md 决策 7/8、Open Questions
PERSIST_INTERVAL_SECS=120
