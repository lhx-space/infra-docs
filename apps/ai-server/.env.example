# apps/ai-server 运行环境变量（风格对齐 apps/collab-server/.env.example）
SERVER_HOST=0.0.0.0
SERVER_PORT=4100
APP_ENV=development
LOG_LEVEL=info
# 与 apps/api / apps/collab-server 的 JWT_SECRET 保持完全一致（见 design.md 决策 3：
# 本地校验 access token 签名，不新增第二套鉴权体系）
JWT_SECRET=secret
# 复用现有 Postgres（pgvector 向量表 document_chunks，见 design.md 决策 12）
DATABASE_URL=postgres://user:password@localhost:5432/yjs-docs
# apps/api gRPC server 的地址（见 design.md 决策 1）；本地用 127.0.0.1 避免 IPv6 歧义，
# docker-compose 部署时换成服务名 http://api:4011
API_GRPC_ADDR=http://127.0.0.1:4011

# ---- 模型路由（见 design.md 决策 5/12）----
# 对话 provider：openai | anthropic | deepseek | ollama
AI_PROVIDER=openai
# provider 的 API key（本地 Ollama 可留空）
AI_API_KEY=
# provider 的 base_url（本地 Ollama 填 http://localhost:11434；docker 内连宿主机用
# http://host.docker.internal:11434；容器内 Ollama 用 http://ollama:11434）
AI_BASE_URL=
# 对话模型（默认值随 provider 变化，见 crates/rig-common/src/config.rs）
AI_MODEL=
# embedding 模型与维度（默认 OpenAI text-embedding-3-small / 1536，见决策 12）
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_NDIMS=1536

# TTS（语音朗读，见 design.md 决策 15）
TTS_MODEL=tts-1
TTS_VOICE=alloy

# 后台索引（见 design.md 决策 11）：增量重索引轮询间隔（秒）与删除对账间隔（秒）
INDEX_INTERVAL_SECS=30
RECONCILE_INTERVAL_SECS=86400

# 会话管理（见 design.md 决策 13）：Redis 会话历史 + TTL + 上下文 token 预算
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECS=86400
MAX_CONTEXT_TOKENS=8000
