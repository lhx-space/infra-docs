{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "description": "API service for .",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.example src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "validate:prisma": "npx prisma validate",
    "generate:prisma": "npx prisma generate",
    "migrate:prisma": "npx prisma migrate dev",
    "migrate:deploy:prisma": "npx prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.8",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
