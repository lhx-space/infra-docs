{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "description": "API service for .",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"pnpm run dev:api\" \"pnpm run dev:worker\"",
    "dev:api": "tsx watch --env-file=.env.example src/server.ts",
    "dev:worker": "tsx watch --env-file=.env.example src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "validate:prisma": "npx prisma validate",
    "generate:prisma": "npx prisma generate",
    "migrate:prisma": "npx prisma migrate dev",
    "migrate:deploy:prisma": "npx prisma migrate deploy",
    "backfill:team-workspace": "tsx --env-file=.env scripts/backfill-team-workspace.ts",
    "verify:grpc-proto": "tsx scripts/verify-grpc-proto.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@luhanxin/tiptap-editor": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/core": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.8",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.3",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "concurrently": "^10.0.4",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
